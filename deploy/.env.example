# QC Suite environment — secrets + bootstrap only.
# Copy this file to .env. Everything operational (PLC connection & I/O map,
# inspection timing, sticker model / device) lives in
# data/json_store/machine_settings.json and is edited from Admin -> Machine Settings.
# Nothing in that file is read from the environment.

# Deployment environment: dev | prod (prod refuses the default secret key)
QC_SUITE_ENV=dev
QC_SUITE_SECRET_KEY=CHANGE_ME_LOCAL_SECRET
# Where json_store/, datasets/ and models/ live
QC_SUITE_DATA_ROOT=./data

# Topology: local-only desktop (embedded backend) or split client/server
QC_SUITE_LOCAL_ONLY=1
QC_SUITE_SERVER_URL=local://embedded
QC_SUITE_HOST=127.0.0.1
QC_SUITE_PORT=8100
QC_SUITE_DEBUG=0

# Client camera / upload (read by the desktop client only)
QC_SUITE_UPLOAD_INTERVAL_MS=150
QC_SUITE_OPERATOR_PREVIEW_FPS=20
QC_SUITE_CAMERA_WIDTH=0
QC_SUITE_CAMERA_HEIGHT=0
QC_SUITE_CAMERA_FPS=0

# Relational mirror for user accounts + inspection push: local | postgresql | sqlserver
QC_SUITE_DATABASE_BACKEND=local

POSTGRESQL_HOST=
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=
POSTGRESQL_SCHEMA=public
POSTGRESQL_SSLMODE=prefer

MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
