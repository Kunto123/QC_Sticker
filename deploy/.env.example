# QC Suite environment — secrets + bootstrap only.
# Copy this file to .env. Everything operational (PLC connection & I/O map,
# inspection timing, sticker model / device) lives in
# data/json_store/machine_settings.json and is edited from Admin -> Machine Settings.
# Nothing in that file is read from the environment.

# Deployment environment: dev | prod (prod refuses the default secret key)
QC_SUITE_ENV=dev
QC_SUITE_SECRET_KEY=CHANGE_ME_LOCAL_SECRET
# Where json_store/, datasets/ and models/ live
QC_SUITE_DATA_ROOT=./data

# Topology: local-only desktop (embedded backend) or split client/server
QC_SUITE_LOCAL_ONLY=1
QC_SUITE_SERVER_URL=local://embedded
QC_SUITE_HOST=127.0.0.1
QC_SUITE_PORT=8100
QC_SUITE_DEBUG=0

# Client camera / upload (read by the desktop client only)
QC_SUITE_UPLOAD_INTERVAL_MS=150
QC_SUITE_OPERATOR_PREVIEW_FPS=20
QC_SUITE_CAMERA_WIDTH=0
QC_SUITE_CAMERA_HEIGHT=0
QC_SUITE_CAMERA_FPS=0

# Relational mirror for user accounts + inspection push: local | postgresql | sqlserver
QC_SUITE_DATABASE_BACKEND=local

POSTGRESQL_HOST=
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=
POSTGRESQL_SCHEMA=public
POSTGRESQL_SSLMODE=prefer

MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# External "operator" table (owned by the plant MES, not this app) that backs
# login + user management on postgresql/sqlserver backends. This table is
# never created or altered by this app — it must already exist. Defaults
# match the schema below; override only if the site's table/columns are
# named differently. Format: QC_SUITE_OPERATOR_COL_<field> = <column name>
#   No        (PK, auto-increment)
#   MC_ID     (this machine's identity — set the value in Admin -> Machine
#              Settings -> Identity, not here)
#   No_RFID   (assigned RFID; also doubles as the login password)
#   Member_ID (username)
#   StatusMP  (role: LEADERPI | OPERATOR)
QC_SUITE_OPERATOR_TABLE=operator
QC_SUITE_OPERATOR_COL_NO=No
QC_SUITE_OPERATOR_COL_MC_ID=MC_ID
QC_SUITE_OPERATOR_COL_RFID=No_RFID
QC_SUITE_OPERATOR_COL_MEMBER_ID=Member_ID
QC_SUITE_OPERATOR_COL_STATUS=StatusMP

# External inspection-result push table (also owned by the plant MES, not
# this app) that HybridInspectionResultsRepository mirrors accepted results
# into. Never created or altered by this app — it must already exist.
# Override only if the site's table/columns are named differently. The
# logical mapping (PartName<-template name / "Preset Name" in Admin ->
# Templates (fallback: expected_class, then part_name), DateCheckMC<-inspected_at,
# MPCheck<-operator username, Data1<-part-ready confidence (whole-number
# percentage string, e.g. "93%"), Data2<-sticker confidence (same format),
# Line<-line_id) is fixed; only the physical
# column names below are configurable. Any of the five may list more than
# one column, comma-separated (no spaces) — the same value is then written
# into every listed column on insert. Below, DateCheckMC's value is also
# duplicated into DateSendDB because pi_boxluggage keeps both columns.
QC_SUITE_INSPECTION_TABLE=pi_boxluggage
QC_SUITE_INSPECTION_COL_ID=No
QC_SUITE_INSPECTION_COL_PART_NAME=PartName
QC_SUITE_INSPECTION_COL_DATE_CHECK_MC=DateCheckMC,DateSendDB
QC_SUITE_INSPECTION_COL_MP_CHECK=MPCheck
QC_SUITE_INSPECTION_COL_DATA1=Data1
QC_SUITE_INSPECTION_COL_DATA2=Data2
QC_SUITE_INSPECTION_COL_LINE=Line

# Read-only column on the same push table, filled by a downstream MES
# process sometime after our insert (never by this app). Every 5 accepted
# judgements successfully pushed, the datapart guard locks further
# judgements until all 5 rows show a filled DatapartID — see
# services/datapart_guard_service.py. Admin -> POST /datapart-guard/override
# force-clears a stuck lock.
QC_SUITE_INSPECTION_COL_DATAPART_ID=DatapartID
